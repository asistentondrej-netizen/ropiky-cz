---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHub from '../../components/SectionHub.astro';
import { NAV } from '../../data/nav';

const section = NAV.find((s) => s.href === '/o-opevneni')!;
---

<BaseLayout
  title={section.title}
  description="Souhrnný úvod do československého opevnění 1935–1938: proč vzniklo, kdo ho stavěl, jaké typy objektů se stavěly, jak byly vyzbrojené a co se s linií stalo po Mnichovu."
>
  <header class="catalog-header">
    <div class="container">
      <div class="article-hero__breadcrumb" style="margin-bottom: var(--s3);">
        <a href="/">Úvod</a> / <span>{section.label}</span>
      </div>
      <h1>{section.title}</h1>
      <p class="article-hero__lead" style="margin-top: var(--s3);">{section.lead}</p>
    </div>
  </header>

  <section>
    <div class="container">
      <SectionHub section={section} />
    </div>
  </section>
</BaseLayout>
