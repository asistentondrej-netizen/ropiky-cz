---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TypologyCard from '../../components/TypologyCard.astro';
import { getCollection } from 'astro:content';

const typologie = (await getCollection('typologie')).sort(
  (a, b) => a.data.order - b.data.order
);

// Pancerove prvky a prototypy — nejsou to samostatne objekty
const isSpecial = (t: any) => t.data.isComponent === true || t.data.isPrototype === true;
// Objekty, ktere existuji jen jako soucast vetsiho celku (delostrelecke tvrze)
const isTvrzovy = (t: any) => !!t.data.parent;

const lehkeMain     = typologie.filter((t) => t.data.category === 'lehke' && !isSpecial(t) && !isTvrzovy(t));
const lehkeSpecial  = typologie.filter((t) => t.data.category === 'lehke' &&  isSpecial(t));
const tezkeMain     = typologie.filter((t) => t.data.category === 'tezke' && !isSpecial(t) && !isTvrzovy(t));
const tezkeTvrzove  = typologie.filter((t) => t.data.category === 'tezke' && !isSpecial(t) &&  isTvrzovy(t));
const tezkeSpecial  = typologie.filter((t) => t.data.category === 'tezke' &&  isSpecial(t));
---

<BaseLayout
  title="Typologie opevnění"
  description="Přehled typů československých pevnostních objektů z let 1935–1938: lehké opevnění (LO vz. 36 a 37) i těžké opevnění (pěchotní sruby, dělostřelecké tvrze)."
>
  <header class="catalog-header">
    <div class="container">
      <div class="article-hero__breadcrumb" style="margin-bottom: var(--s3);">
        <a href="/">Úvod</a> / <a href="/o-opevneni">Opevnění</a> / <span>Typologie</span>
      </div>
      <h1>Typologie opevnění</h1>
      <p class="article-hero__lead" style="margin-top: var(--s3);">
        Československé opevnění zahrnovalo od jednoduchých kulometných srubů až po mohutné
        podzemní tvrze. Každý typ měl svou roli v obranné koncepci.
      </p>
    </div>
  </header>

  <section>
    <div class="container">
      <header class="section-header">
        <span class="section-header__num">I.</span>
        <div class="section-header__content">
          <h2>Lehké opevnění (LO)</h2>
          <p>Kulometné objekty tvořící hustou obrannou síť</p>
        </div>
      </header>

      <div class="typology-grid">
        {lehkeMain.map((t) => <TypologyCard entry={t} />)}
      </div>

      {lehkeSpecial.length > 0 && (
        <div class="typology-special">
          <h3 class="typology-special__title">Speciální případy</h3>
          <p class="typology-special__lead">
            Prototypy a nesériové varianty — v <a href="/katalog">katalogu</a> ani v <a href="/mapa">mapě</a> je samostatně nenajdete.
          </p>
          <div class="typology-grid typology-grid--special">
            {lehkeSpecial.map((t) => <TypologyCard entry={t} />)}
          </div>
        </div>
      )}
    </div>
  </section>

  <section style="padding-top: 0;">
    <div class="container">
      <header class="section-header">
        <span class="section-header__num">II.</span>
        <div class="section-header__content">
          <h2>Těžké opevnění (TO)</h2>
          <p>Pěchotní sruby a dělostřelecké tvrze</p>
        </div>
      </header>

      <div class="typology-grid">
        {tezkeMain.map((t) => <TypologyCard entry={t} />)}
      </div>

      {tezkeTvrzove.length > 0 && (
        <div class="typology-special">
          <h3 class="typology-special__title">Objekty v sestavě dělostřelecké tvrze</h3>
          <p class="typology-special__lead">
            Samostatně nikde nestojí — jsou to specializované objekty, které dávají smysl jen jako část
            <a href="/typologie/delostrelecka-tvrz"> tvrze</a>, propojené s ostatními podzemím.
            Tvrzové <a href="/typologie/pechotni-srub">pěchotní sruby</a> mají stejnou konstrukci jako izolované,
            a najdete je proto přímo u pěchotního srubu.
          </p>
          <div class="typology-grid typology-grid--special">
            {tezkeTvrzove.map((t) => <TypologyCard entry={t} />)}
          </div>
        </div>
      )}

      {tezkeSpecial.length > 0 && (
        <div class="typology-special">
          <h3 class="typology-special__title">Pancéřové prvky a prototypy</h3>
          <p class="typology-special__lead">
            Samostatné prvky, které jsou součástí pěchotního srubu nebo dělostřelecké tvrze — ne celé objekty.
          </p>
          <div class="typology-grid typology-grid--special">
            {tezkeSpecial.map((t) => <TypologyCard entry={t} />)}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
