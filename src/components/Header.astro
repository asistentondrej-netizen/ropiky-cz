---
import SearchBar from './SearchBar.astro';
import { NAV, sectionActive } from '../data/nav';

const { pathname } = Astro.url;
const isActive = (path: string) =>
  pathname === path || (path !== '/' && pathname.startsWith(path));
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-logo">
      <span class="site-logo__primary">Ropiky.cz</span>
      <span class="site-logo__secondary">Opevnění ČSR · 1935–1938</span>
    </a>

    <nav class="site-nav" aria-label="Hlavní navigace">
      {NAV.map((section) => (
        section.children.length === 0 ? (
          <a
            href={section.href}
            class="nav-link"
            aria-current={sectionActive(section, pathname) ? 'page' : undefined}
          >{section.label}</a>
        ) : (
          <div class="nav-item nav-item--dropdown">
            <a
              href={section.href}
              class="nav-link"
              aria-current={sectionActive(section, pathname) ? 'page' : undefined}
            >{section.label}</a>
            <button
              type="button"
              class="nav-caret"
              aria-expanded="false"
              aria-label={`Rozbalit sekci ${section.label}`}
            >
              <svg class="nav-chevron" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="nav-dropdown">
              <a href={section.href} class="nav-dropdown__all">Přehled sekce {section.label}</a>
              {section.children.map((child) => (
                <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a>
              ))}
            </div>
          </div>
        )
      ))}
    </nav>

    <div class="header-actions">
      <SearchBar />
      <button class="nav-toggle" type="button" aria-label="Otevřít menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobilní navigace">
    {NAV.map((section) => (
      <div class="mobile-nav__group">
        <a
          href={section.href}
          class="mobile-nav__heading"
          aria-current={sectionActive(section, pathname) ? 'page' : undefined}
        >{section.label}</a>
        {section.children.map((child) => (
          <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a>
        ))}
      </div>
    ))}
  </nav>
</header>

<style>
  /* Dropdown nav — desktop */
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-med);
    position: relative;
    padding: 4px 0;
    transition: color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: 0;
    font-family: inherit;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] { color: var(--khaki); }
  .nav-caret {
    background: none;
    border: 0;
    padding: 4px 2px;
    cursor: pointer;
    color: var(--ink-med);
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .nav-caret:hover { color: var(--khaki); }
  .nav-chevron { transition: transform 0.2s; }
  .nav-item--dropdown:hover .nav-chevron,
  .nav-item--dropdown:focus-within .nav-chevron,
  .nav-item--dropdown.is-open .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: -12px;
    min-width: 240px;
    background-color: rgba(241, 236, 224, 0.98);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line-soft);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    padding: 6px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
    z-index: 100;
  }
  .nav-item--dropdown:hover .nav-dropdown,
  .nav-item--dropdown:focus-within .nav-dropdown,
  .nav-item--dropdown.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dropdown::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }
  .nav-dropdown a {
    display: block;
    padding: 8px 16px;
    font-size: 0.9rem;
    color: var(--ink);
    transition: background-color 0.15s, color 0.15s;
  }
  .nav-dropdown a:hover,
  .nav-dropdown a[aria-current="page"] {
    background-color: rgba(122, 107, 75, 0.1);
    color: var(--khaki);
  }
  .nav-dropdown__all {
    font-family: var(--font-mono);
    font-size: 0.6875rem !important;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--khaki) !important;
    border-bottom: 1px solid var(--line-soft);
    margin-bottom: 4px;
    padding-bottom: 8px !important;
  }
  /* Override global .site-nav a underline effect inside dropdowns */
  .nav-dropdown a::after { display: none; }

  /* Mobile grouped drawer */
  .mobile-nav__group {
    padding: var(--s2) 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .mobile-nav__group:last-child { border-bottom: none; }
  .mobile-nav__heading {
    display: block;
    margin: 0 0 6px 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--khaki);
  }
  :global(.mobile-nav .mobile-nav__group a) {
    padding: 8px 0 !important;
    border-bottom: none !important;
    font-size: 1rem !important;
  }
  :global(.mobile-nav .mobile-nav__group a.mobile-nav__heading) {
    font-size: 0.6875rem !important;
    padding: 0 0 6px 0 !important;
  }
</style>

<script is:inline>
  (function () {
    const toggle = document.querySelector('.nav-toggle');
    const menu = document.getElementById('mobile-nav');

    function closeDropdowns() {
      document.querySelectorAll('.nav-item--dropdown.is-open').forEach((el) => {
        el.classList.remove('is-open');
        const trig = el.querySelector('.nav-caret');
        if (trig) trig.setAttribute('aria-expanded', 'false');
      });
    }

    if (toggle && menu) {
      function closeMenu() {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('is-open');
        document.body.classList.remove('nav-open');
      }
      function openMenu() {
        toggle.setAttribute('aria-expanded', 'true');
        menu.classList.add('is-open');
        document.body.classList.add('nav-open');
      }

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        if (expanded) closeMenu(); else openMenu();
      });

      menu.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          toggle.focus();
        }
      });

      const mq = window.matchMedia('(min-width: 900px)');
      mq.addEventListener('change', (e) => { if (e.matches) closeMenu(); });
    }

    // Desktop dropdown — sipka prepina, popisek je normalni odkaz
    document.querySelectorAll('.nav-item--dropdown .nav-caret').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const item = trigger.closest('.nav-item--dropdown');
        const isOpen = item.classList.contains('is-open');
        closeDropdowns();
        if (!isOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav-item--dropdown')) closeDropdowns();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDropdowns();
    });
  })();
</script>
