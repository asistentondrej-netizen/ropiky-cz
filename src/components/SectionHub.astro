---
/**
 * Rozcestník sekce — generuje se z src/data/nav.ts, takže dlaždice
 * na rozcestníku a položky v horní liště se nemohou rozejít.
 */
import { getCollection } from 'astro:content';
import type { NavSection } from '../data/nav';

interface Props {
  section: NavSection;
}
const { section } = Astro.props as Props;

const kolekce = ['pevnosti', 'tvrze', 'linie', 'typologie', 'vyzbroj', 'cesty', 'clanky'] as const;
const potreba = new Set(section.children.map((c) => c.count).filter(Boolean));
const pocty: Record<string, number> = {};
for (const k of kolekce) {
  if (potreba.has(k)) pocty[k] = (await getCollection(k as any)).length;
}

const plural = (n: number) => (n === 1 ? 'položka' : n < 5 ? 'položky' : 'položek');
---

<div class="hub-grid">
  {section.children.map((child) => (
    <a href={child.href} class="hub-card">
      <h2 class="hub-card__title">{child.label}</h2>
      {child.blurb && <p class="hub-card__blurb">{child.blurb}</p>}
      <span class="hub-card__meta">
        {child.count && pocty[child.count] !== undefined
          ? `${pocty[child.count].toLocaleString('cs-CZ')} ${plural(pocty[child.count])}`
          : 'Otevřít'}
      </span>
    </a>
  ))}
</div>

<style>
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--s3);
  }
  .hub-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: var(--s4);
    background-color: rgba(241, 236, 224, 0.5);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--khaki);
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .hub-card:hover {
    background-color: rgba(241, 236, 224, 0.9);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.07);
  }
  .hub-card__title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--ink);
  }
  .hub-card__blurb {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-med);
    flex: 1;
  }
  .hub-card__meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--khaki);
  }
  .hub-card::after { display: none; }
</style>
